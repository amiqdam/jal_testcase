# JAL Admissions AI System — Environment Variables
# Copy this file to .env and fill in the values

# --- LLM Provider (Groq) ---
GROQ_API_KEY=gsk_your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3

# --- Database ---
# Default: SQLite (no setup needed)
DATABASE_URL=sqlite:///./jal_admissions.db

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# --- Rate Limiting ---
RATE_LIMIT_PER_MINUTE=10

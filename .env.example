# JAL Admissions AI System — Environment Variables
# Copy this file to .env and fill in the values

# --- LLM Provider ---
# Supported: openai, gemini, claude
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2000

# --- Database ---
# Default: SQLite (no setup needed)
# For PostgreSQL: postgresql://user:pass@localhost:5432/jal_admissions
DATABASE_URL=sqlite:///./jal_admissions.db

# --- App ---
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
